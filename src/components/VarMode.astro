---
const urlsByPath = import.meta.glob('../../public/cartas-sin-borde/*.{jpg,jpeg,png,webp,gif}', {
	query: '?url',
	import: 'default',
	eager: true
});
const thumbUrlsByPath = import.meta.glob('../../public/cartas/thumbs-sin-borde/*.{jpg,jpeg,png,webp,gif}', {
	query: '?url',
	import: 'default',
	eager: true
});

const thumbByName = new Map(
	Object.entries(thumbUrlsByPath).map(([path, src]) => {
		const filename = path.split('/').pop() ?? path;
		return [filename.normalize('NFC'), String(src)];
	})
);

const cartas = Object.entries(urlsByPath)
	.map(([path]) => {
		const filename = path.split('/').pop() ?? path;
		return {
			filename,
			thumbSrc: thumbByName.get(filename.normalize('NFC')) ?? '',
			label: filename
				.replace(/\.(jpe?g|png|webp|gif)$/i, '')
				.replace(/^\d+-/, '')
				.replace(/-/g, ' ')
		};
	})
	.sort((a, b) => a.filename.localeCompare(b.filename, 'es'));
---

<section class="varWrap" aria-label="Modo VAR">
	<header class="varHeader">
		<a class="backLink" href="/">← Baraja normal</a>
		<h1>Modo VAR</h1>
		<p>Sube tus dos cartones y arrastra sus cartas a una rejilla de 4 × 4. Se actualizarán al mismo tiempo que la baraja.</p>
	</header>

	<div id="syncStatus" class="syncStatus" role="status"></div>

	<main class="boards">
		{[1, 2].map((board) => (
			<article class="board" data-board={board}>
				<header class="boardHeader">
					<h2>Cartón {board}</h2>
					<div id={`boardStatus-${board}`} class="boardStatus"></div>
				</header>
				<div class="readyRow">
					<button id={`ready-${board}`} class="readyButton" type="button">Cartón listo</button>
					<span id={`readyStatus-${board}`} class="readyStatus" role="status"></span>
				</div>
				<label class="uploadBox" for={`upload-${board}`}>
					<span>📷 Subir foto del cartón {board}</span>
					<input id={`upload-${board}`} type="file" accept="image/*" />
				</label>
				<img id={`preview-${board}`} class="preview" alt={`Vista previa del cartón ${board}`} hidden />
				<details class="cardPicker" open>
					<summary>Arrastra las cartas de este cartón</summary>
					<div id={`grid-${board}`} class="boardGrid" aria-label={`Rejilla del cartón ${board}`}></div>
					<p class="pickerHint">También puedes tocar una carta para colocarla en el siguiente espacio libre. Toca una casilla para quitarla.</p>
					<div id={`picker-${board}`} class="picker" aria-label={`Cartas disponibles para el cartón ${board}`}></div>
				</details>
			</article>
		))}
	</main>
</section>

<script define:vars={{ cartas }}>
	const DECK_KEY = 'loteria-mexicana:deck-state-v1';
	const BOARD_KEY = 'loteria-mexicana:var-board-';
	const boardSelections = new Map();
	const boardReady = new Map();
	const readyFeedback = new Map();
	const boardLoteriaCalled = new Map();
	const previewUrls = new Map();
	let latestDrawn = new Set();

	function readDrawn() {
		try {
			const state = JSON.parse(localStorage.getItem(DECK_KEY) ?? 'null');
			if (!Array.isArray(state?.deck)) return new Set();
			const idx = Math.min(Math.max(Number(state.idx) || 0, 0), state.deck.length);
			return new Set(state.deck.slice(0, idx));
		} catch {
			return new Set();
		}
	}

	async function readDrawnFromServer() {
		try {
			const response = await fetch('/api/deck', { cache: 'no-store' });
			if (response.ok) {
				const state = await response.json();
				const idx = Math.min(Math.max(Number(state.idx) || 0, 0), state.deck.length);
				return new Set(state.deck.slice(0, idx));
			}
		} catch {
			// Fall back to the local cache when the shared deck service is unavailable.
		}
		return readDrawn();
	}

	function readSelection(board) {
		try {
			const selection = JSON.parse(localStorage.getItem(`${BOARD_KEY}${board}`) ?? '[]');
			if (!Array.isArray(selection)) return Array(16).fill(null);
			const slots = Array(16).fill(null);
			for (const [index, filename] of selection.entries()) {
				if (index >= 16 || !filename || slots.includes(filename)) continue;
				slots[index] = filename;
			}
			return slots;
		} catch {
			return Array(16).fill(null);
		}
	}

	function saveSelection(board) {
		localStorage.setItem(`${BOARD_KEY}${board}`, JSON.stringify(boardSelections.get(board)));
	}

	function readReady(board) {
		return localStorage.getItem(`${BOARD_KEY}${board}-ready`) === 'true';
	}

	function saveReady(board, value) {
		boardReady.set(board, value);
		localStorage.setItem(`${BOARD_KEY}${board}-ready`, String(value));
	}

	function selectedFilenames(slots) {
		return slots.filter(Boolean);
	}

	function placeCard(board, slotIndex, filename) {
		const slots = boardSelections.get(board);
		const oldIndex = slots.indexOf(filename);
		if (oldIndex >= 0) slots[oldIndex] = null;
		slots[slotIndex] = filename;
		saveSelection(board);
		render();
	}

	function addToFirstEmptySlot(board, filename) {
		const slots = boardSelections.get(board);
		const slotIndex = slots.findIndex((slot) => !slot);
		if (slotIndex >= 0) placeCard(board, slotIndex, filename);
	}

	function updateSummary(drawn) {
		const selectedBoards = [...boardSelections.values()].filter((slots) => selectedFilenames(slots).length > 0).length;
		const totalMarked = [...boardSelections.values()].reduce((total, slots) => total + selectedFilenames(slots).length, 0);
		const totalMatched = [...boardSelections.values()].reduce(
			(total, slots) => total + selectedFilenames(slots).filter((filename) => drawn.has(filename)).length,
			0
		);
		const readyCount = [...boardReady.values()].filter(Boolean).length;
		document.getElementById('syncStatus').textContent = selectedBoards
			? `Sincronizado: ${totalMatched} de ${totalMarked} cartas han salido.${readyCount ? ` Cartones listos: ${readyCount}/2.` : ''}`
			: 'Sube tus cartones y selecciona sus cartas para comenzar el seguimiento.';
	}

	function renderBoard(board, drawn) {
		const slots = boardSelections.get(board);
		const selection = new Set(selectedFilenames(slots));
		const grid = document.getElementById(`grid-${board}`);
		const picker = document.getElementById(`picker-${board}`);
		const pickerDetails = grid.closest('.cardPicker');
		const status = document.getElementById(`boardStatus-${board}`);
		const readyButton = document.getElementById(`ready-${board}`);
		const readyStatus = document.getElementById(`readyStatus-${board}`);
		const matched = selectedFilenames(slots).filter((filename) => drawn.has(filename)).length;
		const assembled = selection.size === 16;
		pickerDetails?.classList.toggle('assembled', assembled);
		const complete = selection.size === 16 && selectedFilenames(slots).every((filename) => drawn.has(filename));
		if (complete && !boardLoteriaCalled.get(board)) {
			boardLoteriaCalled.set(board, true);
			speakLoteria(board);
		}
		status.textContent = selection.size ? `${matched} de ${selection.size} salidas` : 'Sin cartas colocadas';
		readyButton.disabled = selection.size !== 16;
		readyButton.textContent = complete || boardReady.get(board) ? '✓ Cartón listo' : 'Cartón listo';
		readyButton.classList.toggle('confirmed', complete || boardReady.get(board));
		readyStatus.textContent = complete
			? '¡Lotería! Cartón completo.'
			: readyFeedback.get(board) ?? (boardReady.get(board) ? '¡Todas las cartas salieron!' : '');
		grid.replaceChildren();
		picker.replaceChildren();

		for (let slotIndex = 0; slotIndex < 16; slotIndex++) {
			const filename = slots[slotIndex];
			const slot = document.createElement('button');
			slot.type = 'button';
			slot.className = 'boardSlot';
			const cardIsDrawn = Boolean(filename && drawn.has(filename));
			slot.classList.toggle('drawn', cardIsDrawn);
			slot.classList.toggle('pending', Boolean(filename && !cardIsDrawn));
			slot.setAttribute('aria-label', filename ? `Quitar ${filename}${cardIsDrawn ? ', ya salió' : ''}` : `Casilla ${slotIndex + 1} vacía`);
			if (filename) {
				const card = cartas.find((item) => item.filename === filename);
				slot.innerHTML = `<img src="${card.thumbSrc}" alt="${card.label}" />${cardIsDrawn ? '<span class="drawnBadge">SALIO</span>' : ''}`;
				slot.addEventListener('click', () => {
					slots[slotIndex] = null;
					saveSelection(board);
					render();
				});
			} else {
				slot.textContent = '+';
			}
			slot.addEventListener('dragover', (event) => event.preventDefault());
			slot.addEventListener('drop', (event) => {
				event.preventDefault();
				const filename = event.dataTransfer?.getData('text/plain');
				if (filename) placeCard(board, slotIndex, filename);
			});
			grid.append(slot);
		}

		for (const card of cartas) {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'cardChoice';
			button.classList.toggle('placed', selection.has(card.filename));
			const cardIsDrawn = drawn.has(card.filename);
			button.classList.toggle('drawn', cardIsDrawn);
			button.classList.toggle('pending', !cardIsDrawn);
			button.draggable = true;
			button.setAttribute('aria-label', `Arrastrar ${card.label}`);
			button.title = card.label;
			button.innerHTML = `<img src="${card.thumbSrc}" alt="${card.label}" loading="lazy" />${cardIsDrawn ? '<span class="drawnBadge">SALIO</span>' : ''}`;
			button.addEventListener('dragstart', (event) => {
				event.dataTransfer?.setData('text/plain', card.filename);
			});
			button.addEventListener('click', () => {
				addToFirstEmptySlot(board, card.filename);
			});
			picker.append(button);
		}
	}

	function speakLoteria(board) {
		if (!('speechSynthesis' in window) || !('SpeechSynthesisUtterance' in window)) return;
		const speech = window.speechSynthesis;
		const utterance = new SpeechSynthesisUtterance(`¡Lotería! El cartón ${board} está completo.`);
		utterance.lang = 'es-MX';
		utterance.rate = 0.85;
		utterance.voice = speech
			.getVoices()
			.find((voice) => voice.lang.toLowerCase().startsWith('es-mx'))
			?? speech.getVoices().find((voice) => voice.lang.toLowerCase().startsWith('es'))
			?? null;
		speech.speak(utterance);
	}

	function render() {
		const drawn = readDrawn();
		latestDrawn = drawn;
		if (drawn.size === 0) {
			for (const board of [1, 2]) {
				saveReady(board, false);
				readyFeedback.delete(board);
				boardLoteriaCalled.set(board, false);
			}
		}
		for (const board of [1, 2]) renderBoard(board, drawn);
		updateSummary(drawn);
	}

	function confirmBoard(board) {
		const slots = boardSelections.get(board);
		const drawn = latestDrawn;
		const selected = selectedFilenames(slots);
		if (selected.length < 16) {
			readyFeedback.set(board, `Coloca las 16 cartas (${16 - selected.length} pendientes).`);
			render();
			return;
		}
		const missing = selected.filter((filename) => !drawn.has(filename));
		if (missing.length) {
			readyFeedback.set(board, `Aún faltan ${missing.length} cartas por salir.`);
			saveReady(board, false);
		} else {
			readyFeedback.set(board, '¡Cartón ganador!');
			saveReady(board, true);
		}
		render();
	}

	async function refreshFromServer() {
		const drawn = await readDrawnFromServer();
		latestDrawn = drawn;
		if (drawn.size === 0) {
			for (const board of [1, 2]) {
				saveReady(board, false);
				readyFeedback.delete(board);
				boardLoteriaCalled.set(board, false);
			}
		}
		for (const board of [1, 2]) renderBoard(board, drawn);
		updateSummary(drawn);
	}

	for (const board of [1, 2]) {
		boardSelections.set(board, readSelection(board));
		boardReady.set(board, readReady(board));
		document.getElementById(`ready-${board}`).addEventListener('click', () => confirmBoard(board));
		document.getElementById(`upload-${board}`).addEventListener('change', (event) => {
			const file = event.target.files?.[0];
			if (!file) return;
			const previousUrl = previewUrls.get(board);
			if (previousUrl) URL.revokeObjectURL(previousUrl);
			const url = URL.createObjectURL(file);
			previewUrls.set(board, url);
			const preview = document.getElementById(`preview-${board}`);
			preview.src = url;
			preview.hidden = false;
		});
	}

	window.addEventListener('loteria:deck-change', refreshFromServer);
	window.addEventListener('storage', (event) => {
		if (event.key === DECK_KEY) refreshFromServer();
	});
	window.addEventListener('pageshow', render);
	render();
	void refreshFromServer();
	window.setInterval(refreshFromServer, 2000);
</script>

<!-- The board and picker cards are created dynamically by the client script,
     so their selectors must remain global rather than Astro-scoped. -->
<style is:global>
	.varWrap {
		min-height: 100dvh;
		box-sizing: border-box;
		padding: 20px;
		background: #0b1020;
		color: #e5e7eb;
	}

	.varHeader,
	.syncStatus,
	.boards {
		width: min(1100px, 100%);
		margin-inline: auto;
	}

	.varHeader {
		text-align: center;
	}

	.backLink {
		color: #93c5fd;
		text-decoration: none;
	}

	h1 {
		margin: 12px 0 4px;
		font-size: clamp(32px, 7vw, 56px);
	}

	.varHeader p {
		margin: 0 auto;
		max-width: 650px;
		color: #cbd5e1;
	}

	.syncStatus {
		margin-top: 18px;
		padding: 12px 16px;
		border: 1px solid #334155;
		border-radius: 12px;
		background: #111827;
		text-align: center;
	}

	.boards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
		margin-top: 18px;
	}

	.board {
		min-width: 0;
		padding: 16px;
		border: 1px solid #334155;
		border-radius: 16px;
		background: #111827;
	}

	.boardHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	h2 {
		margin: 0 0 12px;
	}

	.boardStatus {
		color: #93c5fd;
		font-size: 13px;
	}

	.readyRow {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 38px;
		margin-bottom: 10px;
	}

	.readyButton {
		padding: 9px 13px;
		border: 1px solid #f59e0b;
		border-radius: 9px;
		background: #451a03;
		color: #fef3c7;
		font-weight: 700;
		cursor: pointer;
	}

	.readyButton:disabled {
		border-color: #475569;
		background: #1e293b;
		color: #94a3b8;
		cursor: not-allowed;
	}

	.readyButton.confirmed {
		border-color: #22c55e;
		background: #14532d;
		color: #dcfce7;
	}

	.readyStatus {
		color: #fbbf24;
		font-size: 13px;
	}

	.uploadBox {
		display: block;
		padding: 14px;
		border: 1px dashed #64748b;
		border-radius: 10px;
		color: #bfdbfe;
		text-align: center;
		cursor: pointer;
	}

	.uploadBox input {
		position: absolute;
		width: 1px;
		height: 1px;
		top: auto;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	.preview {
		display: block;
		width: 100%;
		max-height: 280px;
		margin-top: 12px;
		border-radius: 10px;
		object-fit: contain;
		background: #020617;
	}

	.cardPicker {
		margin-top: 14px;
	}

	.cardPicker summary {
		padding: 8px 0;
		color: #e2e8f0;
		cursor: pointer;
	}

	/* Once all 16 cards are placed, keep the assembled board visible but hide
	 * the controls that are only needed while building it. */
	.cardPicker.assembled > summary,
	.cardPicker.assembled .pickerHint,
	.cardPicker.assembled .picker {
		display: none;
	}

	.boardGrid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 6px;
		margin-top: 10px;
		padding: 8px;
		border: 1px solid #334155;
		border-radius: 10px;
		background: #020617;
	}

	.boardSlot {
		position: relative;
		min-width: 0;
		aspect-ratio: 2 / 3;
		padding: 2px;
		border: 1px dashed #64748b;
		border-radius: 5px;
		background: #1e293b;
		color: #94a3b8;
		font-size: 24px;
		cursor: pointer;
		overflow: hidden;
	}

	.boardSlot.drawn {
		border: 4px solid #facc15;
		background: #7f1d1d;
		box-shadow: 0 0 0 3px #ef4444, 0 0 18px 4px rgba(248, 113, 113, 0.8);
	}

	.boardSlot.drawn::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		background:
			linear-gradient(135deg, transparent 40%, rgba(255, 255, 255, 0.3) 40%, rgba(255, 255, 255, 0.3) 48%, transparent 48%),
			repeating-linear-gradient(-45deg, rgba(185, 28, 28, 0.82) 0 9px, rgba(127, 29, 29, 0.82) 9px 18px);
		pointer-events: none;
	}

	.boardSlot.drawn::after {
		content: 'SALIO';
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 3;
		display: grid;
		place-items: center;
		padding: 7px 5px;
		border: 3px solid #fff;
		border-radius: 5px;
		background: #dc2626;
		color: #fff;
		font-size: clamp(10px, 2.2vw, 18px);
		font-weight: 900;
		letter-spacing: 0.08em;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.75);
		text-shadow: 1px 1px 2px #450a0a;
		transform: translate(-50%, -50%) rotate(-8deg);
		pointer-events: none;
	}

	.boardSlot img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Keep pending cards visibly subdued; called cards retain their original
	 * colors and are therefore immediately distinguishable. */
	.boardSlot.pending img,
	.cardChoice.pending img {
		filter: grayscale(100%);
		opacity: 0.5;
	}

	.pickerHint {
		margin: 10px 0 0;
		color: #94a3b8;
		font-size: 12px;
	}

	.picker {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 6px;
		max-height: 430px;
		overflow-y: auto;
		padding-top: 8px;
	}

	.cardChoice {
		position: relative;
		padding: 2px;
		border: 2px solid transparent;
		border-radius: 6px;
		background: #1e293b;
		cursor: pointer;
		opacity: 0.72;
	}

	.cardChoice.placed {
		border-color: #38bdf8;
		opacity: 1;
	}

	.cardChoice.drawn {
		border-color: #facc15;
		box-shadow: 0 0 0 3px #ef4444, 0 0 12px 2px rgba(248, 113, 113, 0.7);
		opacity: 1;
		overflow: hidden;
	}

	.cardChoice.drawn .drawnBadge {
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 2;
		display: grid;
		place-items: center;
		background: repeating-linear-gradient(-45deg, rgba(185, 28, 28, 0.86) 0 8px, rgba(127, 29, 29, 0.86) 8px 16px);
		color: #fff;
		font-size: clamp(11px, 2vw, 16px);
		font-weight: 900;
		letter-spacing: 0.08em;
		text-shadow: 1px 1px 2px #450a0a;
		transform: rotate(-8deg);
	}

	.drawnBadge {
		position: absolute;
		right: 2px;
		bottom: 2px;
		left: 2px;
		padding: 2px 4px;
		border-radius: 4px;
		background: #16a34a;
		color: #f0fdf4;
		font-size: 9px;
		font-weight: 900;
		letter-spacing: 0.04em;
		text-shadow: 0 1px 2px #052e16;
		text-align: center;
	}

	.boardSlot.drawn .drawnBadge {
		top: 0 !important;
		right: 0 !important;
		bottom: 0 !important;
		left: 0 !important;
		z-index: 3;
		display: grid;
		place-items: center;
		border-radius: 3px;
		background: transparent;
		font-size: 14px;
		letter-spacing: 0.12em;
		opacity: 0;
	}

	.cardChoice img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
	}

	@media (max-width: 700px) {
		.varWrap {
			padding: 12px;
		}

		.boards {
			grid-template-columns: 1fr;
		}
	}
</style>
